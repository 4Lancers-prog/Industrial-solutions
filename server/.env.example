# Copy to .env and fill in
PORT=5000
# Local MongoDB, or paste a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/industrial_solutions
# Frontend origin(s) allowed to call the API, comma separated
CLIENT_ORIGIN=http://localhost:5173
# Secret used to read saved enquiries (GET /api/enquiries). Use a long random value.
ADMIN_TOKEN=change-me-to-a-long-random-string
