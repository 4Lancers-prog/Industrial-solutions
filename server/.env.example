# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# All values here are RUNTIME variables for the backend host.

# Port the Node host tells your app to listen on. Many hosts inject PORT
# automatically; keep 5000 for local development.
PORT=5000

# MongoDB connection string.
#  - Local:      mongodb://127.0.0.1:27017/industrial_solutions
#  - Production: a MongoDB Atlas SRV string (SECRET), e.g.
#      mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/industrial_solutions?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/industrial_solutions

# Browser origin(s) allowed to call the API directly via CORS, comma separated.
# With same-origin /api routing (the Worker), set this to the production domain.
#  - Local:      http://localhost:5173
#  - Production: https://industrialsolutions.com
CLIENT_ORIGIN=http://localhost:5173

# Secret for reading saved enquiries (GET /api/enquiries). Use a long random
# value (SECRET). Generate one with:  openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-string
