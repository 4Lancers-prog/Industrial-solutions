# API root used by the frontend (build-time, PUBLIC — never put secrets here).
#
# Leave EMPTY for same-origin "/api" (recommended). This works in development
# (Vite proxies /api to the Express server) and in production when /api is
# routed to the backend on the same domain (the Cloudflare Worker does this).
#
# Only set this if the API lives on a DIFFERENT host, in which case use its
# full API root, e.g.:
#   VITE_API_URL=https://api.industrialsolutions.com/api
VITE_API_URL=

# Public website address, used for Open Graph / meta tags (build-time, PUBLIC).
VITE_SITE_URL=https://industrialsolutions.com
